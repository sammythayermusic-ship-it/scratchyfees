{
  "name": "scratchy",
  "private": true,
  "description": "$SCRATCHY — holder-rewards scratch tickets on Solana, paid in $PUMP (scratchyfees.fun)",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @scratchy/api --filter @scratchy/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sim": "pnpm --filter @scratchy/core sim",
    "db:start": "pnpm --filter @scratchy/api db:start",
    "brand": "tsx scripts/brand/derive.ts",
    "sfx": "tsx scripts/sfx/synth.ts",
    "devnet:setup": "pnpm --filter @scratchy/api devnet:setup",
    "devnet:smoke": "pnpm --filter @scratchy/api devnet:smoke",
    "devnet:fee-inflow": "pnpm --filter @scratchy/api devnet:fee-inflow",
    "devnet:rehearsal": "pnpm --filter @scratchy/api devnet:rehearsal"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
