# ─────────────────────────────────────────────────────────────────────────────
# $SCRATCHY — environment reference. Copy to `.env` (API) and fill in.
# NEVER commit real keys. Defaults here run everything locally with ZERO keys
# (CHAIN_MODE=memory, mock prices). Devnet values come from `pnpm devnet:setup`,
# which writes .env.devnet for you. Mainnet is refused unless ALLOW_MAINNET=yes.
# ─────────────────────────────────────────────────────────────────────────────

# ── PLAN.md §9 economy (defaults are the locked spec values) ────────────────
PAYOUT_RATE=0.005            # round budget B = rate × pool; admin may adjust within 0.003–0.008
ROUND_SECONDS=600            # 10-minute rounds on the clock (:00, :10, …). Rehearsal uses ~20
MIN_HOLD_USD=50              # minimum $SCRATCHY (USD) to play
TICKETS_PER_50=5             # tickets per $50 held
TICKET_CAP=100               # tickets per round cap ($1,000)
MULT_CAP=25                  # whale multiplier cap (mult = clamp(H/1000, 1, 25))
JACKPOT_SHARE=0.10           # share of B accruing to the progressive jackpot
JACKPOT_ODDS=50000           # 1-in-N jackpot roll per scratched ticket
SINGLE_PRIZE_CAP=0.05        # any single ticket prize ≤ 5% of the round's pool snapshot
ROUND_BREAKER=3.0            # realized ticket payouts > 3×B pause payouts (auto-verify, then resume)
MIN_POOL_RESERVE_USD=300     # payouts pause if pool < PUMP worth this at last known price
FEE_SPLIT_POOL=0.70          # 70% of swept fees → PRIZE wallet, 30% → OPS
POOL_TRADING_FEE=0.03        # venue pool trading fee (display, sim, launch config)
MIN_GAS_SOL=0.1              # payouts pause if PRIZE wallet SOL < this (fees + ATA rent)
SWEEP_INTERVAL_MIN=5         # fee sweeper cadence
PRICE_CACHE_SECONDS=30       # price oracle cache
DOMAIN=scratchyfees.fun
API_ORIGIN=https://api.scratchyfees.fun
X_HANDLE=ScratchyFees

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development         # development | test | production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
DEPLOY_ID=local              # written into every payout memo (scratchy:<DEPLOY_ID>:<payoutId>)
DATABASE_URL=postgres://scratchy:scratchy@127.0.0.1:5433/scratchy   # `pnpm db:start` or docker compose
CORS_ORIGINS=                # comma list; empty → https://$DOMAIN in production, localhost:3000 in dev
TRUST_CLOUDFLARE=false       # true ONLY behind Cloudflare with the origin firewalled to CF ranges (or a Tunnel)
ADMIN_TOKEN=                 # required in production, ≥ 32 random chars (admin panel bearer token)

# ── Chain ────────────────────────────────────────────────────────────────────
CHAIN_MODE=memory            # memory (in-process ledger, no keys) | solana
SOLANA_CLUSTER=devnet        # devnet | localnet | mainnet-beta (refused unless ALLOW_MAINNET=yes)
ALLOW_MAINNET=no             # Phase 6 launch checklist only (mainnet also requires PUMP_MINT = PUMP_PRICE_MINT = real PUMP)
RPC_URL=https://api.devnet.solana.com   # Helius recommended: https://devnet.helius-rpc.com/?api-key=…
RPC_WS_URL=                  # optional websocket endpoint (defaults from RPC_URL)
PUMP_MINT=pumpCmXqMfrsAkQ5r49WcJnRayYRqmXz6ae8H7H9Dfn   # mint that prizes are PAID in (devnet: the mock mint)
PUMP_PRICE_MINT=pumpCmXqMfrsAkQ5r49WcJnRayYRqmXz6ae8H7H9Dfn   # mint used for ~$ price quotes (always real PUMP)
SCRATCHY_MINT=               # the $SCRATCHY mint (devnet: the mock mint)
PRIZE_WALLET_KEY=            # HOT wallet secret key (base58 or JSON byte array). Signs payouts. Server env only.
PRIZE_WALLET_ADDRESS=        # must equal the pubkey of PRIZE_WALLET_KEY (boot check)
CREATOR_WALLET_KEY=          # damm-v2 only: fee-claim wallet secret key. NOT used (must be empty) with VENUE=pumpfun
CREATOR_WALLET_ADDRESS=      # damm-v2 only: must equal the pubkey of CREATOR_WALLET_KEY
OPS_WALLET_ADDRESS=          # OPS address only — its key never touches the server. pumpfun: the 30% shareholder (the launch wallet)
EXCLUDED_WALLETS=            # extra comma-separated addresses that can never enter (pool/vaults are auto-excluded)
PRIORITY_FEE_MICROLAMPORTS=20000       # compute-unit price for payout txs
PRIORITY_FEE_MAX_MICROLAMPORTS=500000  # ceiling when escalating on retry
PAYOUT_CONCURRENCY=4         # payout txs in flight at once
ATA_RECREATE_LIMIT=2         # PRIZE opens a wallet's PUMP account at most N times (rent ~0.002 SOL); after that wins wait until the player reopens it. 0 = always pay
HOLDINGS_CACHE_SECONDS=10    # reveal-time re-check cache (first scratch of a batch always reads fresh)
MIN_CREATOR_GAS_SOL=0.05     # CREATOR (fee-claim wallet) SOL floor — alert only

# ── Venue + fee sweeper ──────────────────────────────────────────────────────
# LAUNCH VENUE = pumpfun: $SCRATCHY is a pump.fun Custom Pair quoted in PUMP with a 3% creator fee, and pump.fun's
# "Share creator rewards" pays 70% → PRIZE / 30% → OPS on-chain. PRIZE claims permissionlessly (it pays the gas);
# no CREATOR wallet exists. Boot refuses to start unless the coin is quoted in PUMP, its creator IS the sharing
# config, and the shareholders are exactly PRIZE at FEE_SPLIT_POOL and OPS at the rest.
VENUE=memory                 # memory | pumpfun (launch) | damm-v2 (Meteora DAMM v2 pool; devnet rehearsals only — PUMP has no DAMM v2 badge on mainnet)
VENUE_POOL_ADDRESS=          # damm-v2: pool address (pumpfun derives everything from SCRATCHY_MINT)
VENUE_POSITION_ADDRESS=      # damm-v2: CREATOR-owned (locked) position that earns the 3% fees
SWAP=none                    # none (fees arrive in PUMP only: pumpfun, or DAMM v2 collectFeeMode=OnlyB) | jupiter | damm-v2 | memory
SWAP_POOL_ADDRESS=           # pool for SWAP=damm-v2 (devnet: the BothToken test pool); default VENUE_POOL_ADDRESS
SWEEP_MAX_SLIPPAGE_BPS=300   # slippage cap if a SCRATCHY→PUMP swap is ever needed
SWEEPER_ENABLED=true

# ── Prices ───────────────────────────────────────────────────────────────────
PRICE_SOURCE=mock            # live (Jupiter → DexScreener) | mock
JUPITER_API_BASE=https://api.jup.ag
JUPITER_API_KEY=             # optional (keyless works at low rate; we poll every 30s)
DEXSCREENER_API_BASE=https://api.dexscreener.com
MOCK_PUMP_USD=0.0056         # PUMP/USD used when PRICE_SOURCE=mock

# ── Alerts (Telegram) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # from @BotFather; empty = log-only
TELEGRAM_CHAT_ID=            # ops channel/chat id
TELEGRAM_DIGEST_SECONDS=5    # routine payouts are batched into digests; big wins/jackpots/failures post instantly

# ── Engine + anti-abuse ──────────────────────────────────────────────────────
ENGINE_ENABLED=true          # run the round engine + payout worker + sweeper in this process
RESERVE_HYSTERESIS=0.10      # resume a low_pool/low_gas pause only at threshold × 1.10
REQUIRE_HOLD_ONE_ROUND=false # PLAN §7 optional knob (off at launch): eligible balance must predate the drop by a round
MAX_WALLETS_PER_IP_PER_ROUND=3
SESSION_LOCK_SECONDS=45      # one scratching session per wallet per round; lock lease length
RATE_LIMIT_ENTER_PER_MIN=20  # per IP
RATE_LIMIT_SCRATCH_PER_MIN=240   # per IP
RATE_LIMIT_WALLET_PER_MIN=300    # per wallet
DEV_FORCE_JACKPOT=false      # devnet-only rehearsal helper; refused on mainnet
DEV_FORCE_JACKPOT_WALLET=    # rehearsal wallet whose ticket 0 is ground into a jackpot (with DEV_FORCE_JACKPOT=true)
DEV_FORCE_JACKPOT_ROUND=0    # with DEV_FORCE_JACKPOT: only this round id (0 = every round); devnet only
DEV_FORCE_BREAKER_ROUND=0    # rehearsal drill: this round id runs with a 1-ppm breaker (any win trips it); devnet only

# ── Web (apps/web — put these in apps/web/.env.local) ─────────────────────────
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000    # prod: https://api.scratchyfees.fun
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws       # prod: wss://api.scratchyfees.fun/ws
NEXT_PUBLIC_SITE_URL=http://localhost:3000      # prod: https://scratchyfees.fun
NEXT_PUBLIC_SOLANA_CLUSTER=devnet               # Solscan links (?cluster=devnet)
NEXT_PUBLIC_X_HANDLE=ScratchyFees
