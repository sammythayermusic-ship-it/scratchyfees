# syntax=docker/dockerfile:1
#
# $SCRATCHY API image (round engine, payouts, fee sweeper — ONE process). Build context = the REPO ROOT:
#   docker build -f deploy/Dockerfile.api -t scratchy-api .
#   fly deploy . --config deploy/fly.api.toml --dockerfile deploy/Dockerfile.api --ha=false
# Runs the TypeScript straight through tsx (same as deploy/scratchy-api.service); migrations run at boot.

FROM node:22-slim AS build
ENV CI=true
RUN npm install --global pnpm@11.27.1
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
RUN pnpm install --frozen-lockfile --filter "@scratchy/api..."
COPY tsconfig.base.json ./
COPY packages/core packages/core
COPY apps/api apps/api

FROM node:22-slim AS runtime
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4000
WORKDIR /repo
COPY --from=build --chown=node:node /repo /repo
USER node
EXPOSE 4000
STOPSIGNAL SIGTERM
WORKDIR /repo/apps/api
CMD ["node", "--import", "tsx", "src/main.ts"]
