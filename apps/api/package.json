{
  "name": "@scratchy/api",
  "version": "0.1.0",
  "private": true,
  "description": "$SCRATCHY API: round engine, payouts, fee sweeper, websocket feed (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:start": "tsx scripts/db-start.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@scratchy/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
